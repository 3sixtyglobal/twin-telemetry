{
	"__inputs": [],
	"__requires": [
		{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
		{ "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
		{ "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
		{ "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
		{ "type": "panel", "id": "stat", "name": "Stat", "version": "" }
	],
	"annotations": { "list": [] },
	"editable": false,
	"fiscalYearStartMonth": 0,
	"graphTooltip": 1,
	"id": null,
	"links": [],
	"liveNow": false,
	"panels": [
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "palette-classic" },
					"custom": { "lineWidth": 2, "fillOpacity": 10 },
					"unit": "reqps"
				},
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
			"id": 1,
			"options": {
				"legend": { "calcs": ["last", "max"], "displayMode": "list", "placement": "bottom" },
				"tooltip": { "mode": "multi" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "rate(api_requests_total[1m])",
					"legendFormat": "{{route}} {{status_code}}",
					"refId": "A"
				}
			],
			"title": "API Request Rate (req/s)",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "palette-classic" },
					"custom": { "lineWidth": 2, "fillOpacity": 10 },
					"unit": "short",
					"min": 0
				},
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
			"id": 2,
			"options": {
				"legend": { "calcs": ["last", "min", "max"], "displayMode": "list", "placement": "bottom" },
				"tooltip": { "mode": "multi" }
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "active_connections",
					"legendFormat": "connections",
					"refId": "A"
				}
			],
			"title": "Active Connections",
			"type": "timeseries"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": {
						"mode": "thresholds"
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 65 },
							{ "color": "orange", "value": 70 },
							{ "color": "red", "value": 75 }
						]
					},
					"unit": "celsius",
					"min": 40,
					"max": 90
				},
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
			"id": 3,
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"orientation": "auto",
				"showThresholdLabels": false,
				"showThresholdMarkers": true
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "cpu_temperature",
					"legendFormat": "temperature",
					"refId": "A"
				}
			],
			"title": "CPU Temperature",
			"type": "gauge"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"thresholds": {
						"mode": "absolute",
						"steps": [{ "color": "blue", "value": null }]
					},
					"unit": "short"
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
			"id": 4,
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "background"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "api_requests_total",
					"legendFormat": "total",
					"refId": "A"
				}
			],
			"title": "API Requests Total",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"thresholds": {
						"mode": "absolute",
						"steps": [{ "color": "green", "value": null }]
					},
					"unit": "short"
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
			"id": 5,
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "background"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "active_connections",
					"legendFormat": "current",
					"refId": "A"
				}
			],
			"title": "Current Connections",
			"type": "stat"
		},
		{
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 65 },
							{ "color": "red", "value": 75 }
						]
					},
					"unit": "celsius"
				},
				"overrides": []
			},
			"gridPos": { "h": 4, "w": 8, "x": 16, "y": 16 },
			"id": 6,
			"options": {
				"reduceOptions": { "calcs": ["lastNotNull"] },
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "background"
			},
			"targets": [
				{
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "cpu_temperature",
					"legendFormat": "current",
					"refId": "A"
				}
			],
			"title": "Current CPU Temperature",
			"type": "stat"
		}
	],
	"refresh": "5s",
	"schemaVersion": 38,
	"tags": ["twin", "telemetry", "opentelemetry"],
	"templating": { "list": [] },
	"time": { "from": "now-5m", "to": "now" },
	"timepicker": {},
	"timezone": "browser",
	"title": "TWIN Telemetry",
	"uid": "twin-telemetry-otel",
	"version": 1
}
