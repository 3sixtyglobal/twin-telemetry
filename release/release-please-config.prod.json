{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"description": "Auto-Generated Release Please configuration for prod",
	"pull-request-title-pattern": "chore: prod release prepared",
	"pull-request-header": "chore: prod release prepared",
	"pull-request-footer": "This PR was generated by the Release Production GHA",
	"release-type": "node",
	"initial-version": "0.0.1",
	"versioning": "default",
	"packages": {
		"packages/telemetry-models": {
			"package-name": "telemetry-models",
			"changelog-path": "docs/changelog.md"
		},
		"packages/telemetry-connector-entity-storage": {
			"package-name": "telemetry-connector-entity-storage",
			"changelog-path": "docs/changelog.md"
		},
		"packages/telemetry-connector-opentelemetry": {
			"package-name": "telemetry-connector-opentelemetry",
			"changelog-path": "docs/changelog.md"
		},
		"packages/telemetry-service": {
			"package-name": "telemetry-service",
			"changelog-path": "docs/changelog.md"
		},
		"packages/telemetry-rest-client": {
			"package-name": "telemetry-rest-client",
			"changelog-path": "docs/changelog.md"
		},
		"packages/telemetry-producers": {
			"package-name": "telemetry-producers",
			"changelog-path": "docs/changelog.md"
		}
	},
	"plugins": [
		"node-workspace",
		{
			"type": "linked-versions",
			"groupName": "repo",
			"components": [
				"telemetry-models",
				"telemetry-connector-entity-storage",
				"telemetry-connector-opentelemetry",
				"telemetry-service",
				"telemetry-rest-client",
				"telemetry-producers"
			]
		}
	]
}
